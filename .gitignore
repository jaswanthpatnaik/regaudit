# =============================================================================
# RegAudit — Git Ignore Configuration
# =============================================================================

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Databases and Runtime State
data/*.db
data/*.db-wal
data/*.db-shm
*.sqlite
*.sqlite3
!data/.gitkeep

# Application Logs
logs/*.log
logs/*.log.*
*.log
!logs/.gitkeep

# OS & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary & Scratch Files
*.tmp
scratch/
